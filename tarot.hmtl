 ['y','ბალანსი, მოქნილობა, რამდენიმე საქმის ერთდროულად წარმართვა.','გადატვირთვა, ცუდი ფინანსური მართვა, დისბალანსი.'],
 ['y','გუნდური მუშაობა, ოსტატობა, თანამშრომლობა.','უთანხმოება გუნდში, დაბალი ხარისხი, მოტივაციის ნაკლებობა.'],
 ['m','კონტროლი, დაზოგვა, უსაფრთხოება, ფლობის სურვილი.','სიძუნწე, ზედმეტი კონტროლი ან უყაირათობა, გაშვების სწავლა.'],
 ['n','ფინანსური სირთულე, გარიყულობა, მატერიალური დანაკარგი.','აღდგენა, დახმარების მიღება, სირთულის დასასრული.'],
 ['y','გულუხვობა, გაცემა და მიღება, ბალანსი, ქველმოქმედება.','ვალები, ცალმხრივი გაცემა, პირობითი დახმარება.'],
 ['m','მოთმინება, გრძელვადიანი ხედვა, ინვესტიცია, შედეგის მოლოდინი.','მოუთმენლობა, ცუდი ინვესტიცია, უშედეგო შრომა.'],
 ['y','შრომისმოყვარეობა, ოსტატობის სრულყოფა, დეტალებზე ყურადღება.','პერფექციონიზმი, მონოტონურობა, ზერელე შრომა.'],
 ['y','დამოუკიდებლობა, ფუფუნება, თვითკმარობა, ნაყოფის მოწევა.','ზედმეტი შრომა, ფინანსური დამოკიდებულება, ზედაპირული კეთილდღეობა.'],
 ['y','სიმდიდრე, მემკვიდრეობა, ოჯახის სტაბილურობა, გრძელვადიანი წარმატება.','ოჯახური დავა ქონებაზე, ფინანსური არასტაბილურობა.'],
 ['y','სწავლა, ახალი პრაქტიკული შესაძლებლობა, მიზანდასახულობა.','დაუდევრობა, პროგრესის ნაკლებობა, გადადება.'],
 ['y','საიმედოობა, მეთოდურობა, ნელი, მაგრამ მყარი წინსვლა.','სიჯიუტე, მოწყენილობა, სტაგნაცია.'],
 ['y','მზრუნველობა, პრაქტიკულობა, სიუხვე, მიწიერი სითბო.','თავის უგულებელყოფა, მატერიალიზმი, საქმესა და სახლს შორის დისბალანსი.'],
 ['y','სიმდიდრე, ბიზნესი, უსაფრთხოება, მატერიალური ოსტატობა.','სიხარბე, მატერიალიზმი, სიჯიუტე ფინანსებში.'],
]};

/* build the 78-card deck */
const DECK=[];
MAJORS.forEach((m,i)=>DECK.push({id:'M'+i,major:true,n:i,name:m[0],astro:m[1],glyph:m[2],yn:m[3],up:m[4],rv:m[5],el:'major'}));
for(const s of Object.keys(SUITS))MINORS[s].forEach((m,i)=>{
  const r=i+1;
  DECK.push({id:s+r,major:false,suit:s,rank:r,name:`${RANK_KA[r]} ${SUITS[s].gen}`,
    yn:m[0],up:m[1],rv:m[2],el:SUITS[s].el});
});

/* ── suit icons (original line drawings) ── */
const ICON={
 wands:'<path d="M12 2.5v19"/><path d="M12 7c2.5-.4 4-1.8 4.6-4"/><path d="M12 11c-2.5-.4-4-1.8-4.6-4"/><path d="M12 15c2.5-.4 4-1.8 4.6-4"/>',
 cups:'<path d="M6 4h12v3.5a6 6 0 0 1-12 0z"/><path d="M12 13.5v5"/><path d="M8 20.5h8"/>',
 swords:'<path d="M12 2l2 3v10.5h-4V5z"/><path d="M7 15.5h10"/><path d="M12 15.5V22"/>',
 pentacles:'<circle cx="12" cy="12" r="9.5"/><path d="M12 5L16.11 17.66L5.34 9.84H18.66L7.89 17.66Z"/>',
};
const svgIcon=s=>`<svg viewBox="0 0 24 24">${ICON[s]}</svg>`;
const BACK=`<svg viewBox="0 0 100 166" preserveAspectRatio="none"><defs><pattern id="bp" width="16" height="16" patternUnits="userSpaceOnUse">
  <path d="M8 0L16 8L8 16L0 8Z" fill="none" stroke="rgba(201,168,76,.18)" stroke-width=".7"/></pattern></defs>
  <rect width="100" height="166" fill="url(#bp)"/><rect x="5" y="5" width="90" height="156" rx="4" fill="none" stroke="rgba(201,168,76,.55)" stroke-width=".8"/>
  <circle cx="50" cy="83" r="20" fill="#130d24" stroke="rgba(201,168,76,.6)" stroke-width=".8"/>
  <polygon points="50,66 64,92 36,92" fill="none" stroke="rgba(201,168,76,.6)" stroke-width=".7"/>
  <polygon points="50,100 36,74 64,74" fill="none" stroke="rgba(201,168,76,.6)" stroke-width=".7"/>
  <circle cx="50" cy="83" r="2" fill="rgba(201,168,76,.8)"/></svg>`;

function faceHTML(c,rev){
  let top,art;
  if(c.major){top=ROMAN[c.n];art=`<div class="big">${c.glyph}\uFE0E</div>`;}
  else if(c.rank===1){top='A';art=`<div class="solo">${svgIcon(c.suit)}</div>`;}
  else if(c.rank<=10){top=String(c.rank);art=`<div class="pips">${svgIcon(c.suit).repeat(c.rank)}</div>`;}
  else{top=RANK_SHORT[c.rank];art=`<div class="court">${svgIcon(c.suit)}<span>${RANK_SHORT[c.rank]}</span></div>`;}
  return `<div class="cf el-${c.el}${rev?' rev':''}"><div class="cf-top">${top}</div><div class="cf-art">${art}</div><div class="cf-name">${c.name}</div></div>`;
}

