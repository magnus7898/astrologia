 {id:'money',g:'საქმე და ფინანსები',t:'ფინანსები',d:'ოთხი ბარათი ფულის ენერგიაზე.',
  p:[['ახლანდელი მდგომარეობა','ფინანსური ფონი',1,1],['რა ბლოკავს','რა აჩერებს შემოსავალს',2,1],['რა ზრდის','რა გაზრდის სიუხვეს',3,1],['რჩევა','პრაქტიკული ნაბიჯი',4,1]]},

 {id:'shadow',g:'სიღრმე',t:'ჩრდილის მუშაობა',d:'ხუთი ბარათი შენი ჩრდილის გასაცნობად და მის ინტეგრაციისთვის.',
  p:[['ჩემი ჩრდილი','რას ვერ ვხედავ ან ვმალავ',1,1],['საიდან მოდის','ფესვი, წარმოშობა',2,1],['როგორ ვლინდება','სად ჩანს ცხოვრებაში',3,1],['რას მასწავლის','ჩრდილის საჩუქარი',4,1],['ინტეგრაცია','როგორ მივიღო და გამოვიყენო',5,1]]},
 {id:'horseshoe',g:'სიღრმე',t:'ნალი',d:'შვიდბარათიანი კლასიკური განლაგება ვითარების სრული სურათისთვის.',
  p:[['წარსული','რამაც განაპირობა',1,1],['აწმყო','ახლანდელი ვითარება',2,2],['ფარული გავლენები','რაც არ ჩანს',3,3],['დაბრკოლება','მთავარი სირთულე',4,4],['გარემო','სხვების გავლენა',5,3],['რჩევა','როგორ მოიქცე',6,2],['შედეგი','სავარაუდო დასასრული',7,1]]},
 {id:'celtic',g:'სიღრმე',t:'კელტური ჯვარი',d:'ათი ბარათი — ყველაზე სრული კლასიკური განლაგება.',
  p:[['ვითარება','საკითხის გული',2,2],['გადამკვეთი','რა გეღობება ან რა გეხმარება',2,2,true],['ფესვი','ქვეცნობიერი საფუძველი',2,3],['წარსული','რაც მიდის',1,2],['გვირგვინი','ცნობიერი მიზანი, საუკეთესო შესაძლებლობა',2,1],['უახლოესი მომავალი','რაც მოდის',3,2],
     ['შენ','შენი დამოკიდებულება',5,4],['გარემო','სხვები და გარემოებები',5,3],['იმედები და შიშები','რას ელი და რისი გეშინია',5,2],['შედეგი','საით მიდის ყველაფერი',5,1]]},
 {id:'newmoon',g:'მთვარის ციკლი',t:'ახალი მთვარე',d:'ოთხი ბარათი განზრახვების დასასახად.',
  p:[['რას ვრგავ','ახალი განზრახვა',1,1],['რას ვუშვებ','რაც აღარ მჭირდება',2,1],['რა მეხმარება','მოკავშირე ენერგია',3,1],['პირველი ნაბიჯი','საიდან დავიწყო',4,1]]},
 {id:'fullmoon',g:'მთვარის ციკლი',t:'სავსე მთვარე',d:'ოთხი ბარათი ციკლის კულმინაციისთვის.',
  p:[['რა დასრულდა','რა მოიწია',1,1],['რა გამოჩნდა','რა გაცხადდა',2,1],['რა უნდა გავუშვა','რისგან უნდა გავთავისუფლდე',3,1],['მადლიერება','რისთვის ვარ მადლიერი',4,1]]},
 {id:'year',g:'მთვარის ციკლი',t:'წელიწადი წინ',d:'წლის თემა და თითო ბარათი მომდევნო 12 თვიდან თითოეულზე.',year:true,p:[]},
];
/* year spread: theme + 12 months starting this month */
(()=>{
  const sp=SPREADS.find(s=>s.id==='year');
  const MON=['იანვარი','თებერვალი','მარტი','აპრილი','მაისი','ივნისი','ივლისი','აგვისტო','სექტემბერი','ოქტომბერი','ნოემბერი','დეკემბერი'];
  const now=new Date();
  sp.p.push(['წლის თემა','მთავარი ენერგია მთელი წლისთვის',2,1]);
  for(let i=0;i<12;i++){
    const m=(now.getMonth()+i)%12,y=now.getFullYear()+Math.floor((now.getMonth()+i)/12);
    sp.p.push([`${MON[m]} ${y}`,'თვის ენერგია',1+(i%3),2+Math.floor(i/3)]);
  }
})();

/* ════════════════════════════════════════════════════════════════
   ANALYSIS
   ════════════════════════════════════════════════════════════════ */
const EL={fire:['ცეცხლი','მოქმედება, ვნება, ნება, შემოქმედებითი იმპულსი','var(--fire)'],
          water:['წყალი','ემოციები, ურთიერთობები, ინტუიცია','var(--water)'],
          air:['ჰაერი','აზრები, კომუნიკაცია, გადაწყვეტილებები, კონფლიქტი','var(--air)'],
          earth:['მიწა','მატერია, ფული, სხეული, სტაბილურობა','var(--earth)']};
const RANK_MSG={1:'ახალი დასაწყისები — რამდენიმე სფეროში ერთდროულად იწყება რაღაც ახალი',
 2:'არჩევანი და პარტნიორობა — ბალანსის პოვნა ორ ძალას შორის',3:'ზრდა და თანამშრომლობა — პირველი ნაყოფი',
 4:'სტაბილიზაცია — საფუძვლის აგება, ზოგჯერ ჩარჩენაც',5:'კონფლიქტი და ცვლილება — დაძაბულობა, რომელიც ზრდას იწვევს',
 6:'ჰარმონია და აღდგენა — ბალანსი ბრუნდება',7:'გამოცდა და შეფასება — სიღრმისეული გადახედვა',
 8:'მოძრაობა და ძალა — ტემპი იზრდება',9:'კულმინაცია — თითქმის დასრულებული ციკლი',
 10:'დასრულება — ციკლი იხურება, ახალი ახლოვდება',11:'ცნობები და სწავლა — ახალი ინფორმაცია მოდის',
 12:'მოძრაობა და ქმედება — მოვლენები სწრაფად ვითარდება',13:'შინაგანი ოსტატობა — ემოციური და ინტუიციური სიმწიფე',
 14:'გარეგანი ავტორიტეტი — კონტროლი, პასუხისმგებლობა, ლიდერობა'};
const YN_W={y:1,m:0,n:-1};
function ynOf(c,rev){const v=YN_W[c.yn];return rev?(v>0?0:-1):v;}   /* reversed: yes→maybe, maybe→no */
/* quintessence: majors count their number, pips their rank, courts 0;
   reduced by digit sum while above 22 (same as the matrix r22); 22 → 0 */
function r22(n){while(n>22)n=String(n).split('').reduce((a,d)=>a+ +d,0);return n;}
function quintessence(drawn){
  const s=drawn.reduce((a,{c})=>a+(c.major?c.n:(c.rank<=10?c.rank:0)),0);
  if(!s)return null;
  const q=r22(s);return {sum:s,n:q===22?0:q};
}
function analyse(sp,drawn){
  const n=drawn.length,out=[];
  const cnt={fire:0,water:0,air:0,earth:0},ranks={};
  let maj=0,rev=0,courts=0;
  for(const {c,rev:r} of drawn){
    if(c.major)maj++;else{cnt[c.el]++;ranks[c.rank]=(ranks[c.rank]||0)+1;if(c.rank>10)courts++;}
    if(r)rev++;
  }
  const minors=n-maj;
  let bars='<div class="bars">';
  for(const k of ['fire','water','air','earth']){const v=cnt[k],p=minors?v/minors*100:0;
    bars+=`<div class="bar">${EL[k][0]} — ${v}<div class="tr"><i style="width:${p}%;background:${EL[k][2]}"></i></div></div>`;}
  bars+=`<div class="bar">დიდი არკანი — ${maj}<div class="tr"><i style="width:${n?maj/n*100:0}%;background:var(--major)"></i></div></div></div>`;
  if(minors){
    const mx=Math.max(...Object.values(cnt));
    const dom=Object.keys(cnt).filter(k=>cnt[k]===mx&&mx>0);
    if(dom.length===1&&mx>=2)out.push(`დომინანტი ელემენტი — <b>${EL[dom[0]][0]}</b>: ${EL[dom[0]][1]}. ვითარების მთავარი ენა სწორედ ესაა.`);
    if(n>=5){const miss=Object.keys(cnt).filter(k=>!cnt[k]);
      if(miss.length&&miss.length<4)out.push(`აკლია: <b>${miss.map(k=>EL[k][0]).join(', ')}</b> — ${miss.map(k=>EL[k][1].split(',')[0]).join(', ')} ამჟამად ნაკლებად მონაწილეობს; ღირს ამ მხარის გაძლიერება.`);}
  }
  if(n>=3){
    if(maj/n>=.5)out.push('დიდი არკანი ჭარბობს — ეს ბედისწერის მნიშვნელობის ვითარებაა, ღრმა ცვლილებები და გაკვეთილები მიმდინარეობს.');
    else if(maj===0)out.push('დიდი არკანი არ არის — ვითარება ყოველდღიური დონისაა და მეტწილად შენს ხელშია.');
    if(rev/n>=.5)out.push('შებრუნებული ბარათები ჭარბობს — ენერგია შინაგანადაა მიმართული: შენელება, დაბლოკვა ან ფარული პროცესები.');
    if(courts>=2)out.push(`სასახლის ${courts} ბარათი — ვითარებაში ჩართულია სხვა ადამიანები ან შენი პიროვნების სხვადასხვა მხარე.`);
  }
  for(const [r,k] of Object.entries(ranks))if(k>=2)out.push(`${k}× ${RANK_KA[r]} — ${RANK_MSG[r]}.`);
  const q=quintessence(drawn);
  let html=`<div class="summary"><h4>ენერგიების ბალანსი</h4>${bars}${out.map(t=>`<div class="insight">${t}</div>`).join('')}`;
  if(q){const M=MAJORS[q.n];html+=`<div class="quint">კვინტესენცია: ${drawn.map(({c})=>c.major?c.n:(c.rank<=10?c.rank:0)).join(' + ')} = ${q.sum} → <b>${ROMAN[q.n]} ${M[0]}</b> — ${M[4]} <span style="color:var(--ink-dim)">(მთლიანი განლაგების ფარული რჩევა)</span></div>`;}
  if(sp.health)html+='<div class="health">⚠ ტარო არ ცვლის ექიმს. ჯანმრთელობის პრობლემისას მიმართე სპეციალისტს.</div>';
  return html+'</div>';
}

/* ════════════════════════════════════════════════════════════════
   UI
   ════════════════════════════════════════════════════════════════ */
const $=id=>document.getElementById(id);
let cur=SPREADS[0],drawn=[],question='';
function rnd(n){const a=new Uint32Array(1);crypto.getRandomValues(a);return a[0]%n;}
function shuffle(){const d=DECK.slice();for(let i=d.length-1;i>0;i--){const j=rnd(i+1);[d[i],d[j]]=[d[j],d[i]];}return d;}

function renderGroups(){
  const gs=[...new Set(SPREADS.map(s=>s.g))];
  $('groups').innerHTML=gs.map(g=>`<div><div class="grp-t">${g}</div><div class="chips">${
    SPREADS.filter(s=>s.g===g).map(s=>`<button class="chip${s===cur?' on':''}" data-id="${s.id}">${s.t}<small>${s.p.length}</small></button>`).join('')}</div></div>`).join('');
  $('groups').querySelectorAll('.chip').forEach(b=>b.onclick=()=>select(b.dataset.id));
}
function select(id){
  cur=SPREADS.find(s=>s.id===id);renderGroups();
  $('sp-title').textContent=`${cur.t} · ${cur.p.length} ბარათი`;
  $('sp-desc').textContent=cur.d;
  $('ab-names').classList.toggle('show',!!cur.ab);
  drawn=[];$('table').innerHTML='';$('reading').classList.remove('show');$('actions').classList.remove('show');
  layoutEmpty();
}
function posLabel(i){
  let t=cur.p[i][0];
  if(cur.ab){const a=$('opt-a').value.trim(),b=$('opt-b').value.trim();
    if(a)t=t.replace(/^A:/,a+':');if(b)t=t.replace(/^B:/,b+':');}
  return t;
}
function gridSize(){return [Math.max(...cur.p.map(p=>p[2])),Math.max(...cur.p.map(p=>p[3]))];}
function layoutEmpty(){
  const [cols,rows]=gridSize(),t=$('table');
  t.style.gridTemplateColumns=`repeat(${cols},calc(var(--cw) + 16px))`;
  t.style.gridTemplateRows=`repeat(${rows},auto)`;
  t.innerHTML=cur.p.map((p,i)=>`<div class="slot${p[4]?' cross':''}" style="grid-column:${p[2]};grid-row:${p[3]}">
     <div class="pn"><b>${i+1}</b>${posLabel(i)}</div>
     <div style="width:var(--cw);height:var(--ch);border:1px dashed rgba(201,168,76,.18);border-radius:7px${p[4]?';transform:rotate(90deg)':''}"></div></div>`).join('');
}
function draw(){
  const deck=shuffle(),useRev=$('rev').checked;
  question=$('question').value.trim();
  drawn=cur.p.map((p,i)=>({c:deck[i],rev:useRev&&rnd(2)===1,up:false}));
  const [cols,rows]=gridSize(),t=$('table');
  t.style.gridTemplateColumns=`repeat(${cols},calc(var(--cw) + 16px))`;
  t.style.gridTemplateRows=`repeat(${rows},auto)`;
  t.innerHTML=cur.p.map((p,i)=>`<div class="slot${p[4]?' cross':''}" style="grid-column:${p[2]};grid-row:${p[3]}">
     <div class="pn"><b>${i+1}</b>${posLabel(i)}</div>
     <div class="card3d" data-i="${i}" style="animation-delay:${i*70}ms"><div class="inner">
       <div class="face back-f">${BACK}</div><div class="face front">${faceHTML(drawn[i].c,drawn[i].rev)}</div></div></div></div>`).join('');
  t.querySelectorAll('.card3d').forEach(el=>el.onclick=()=>flip(+el.dataset.i));
  $('actions').classList.add('show');
  renderReading();
}
function flip(i){
  if(drawn[i].up)return;drawn[i].up=true;
  $('table').querySelector(`.card3d[data-i="${i}"]`).classList.add('up');
  renderReading();
}
function flipAll(){drawn.forEach((_,i)=>setTimeout(()=>flip(i),i*120));}
function cardTags(c){
  return c.major?`დიდი არკანი ${ROMAN[c.n]} · ${c.astro}`:`${SUITS[c.suit].ka} · ${SUITS[c.suit].elka}`;
}
function renderReading(){
  const R=$('reading');R.classList.add('show');
  const up=drawn.filter(d=>d.up).length;
  let h=`<h3>${cur.t}</h3>${question?`<div class="q">„${question.replace(/</g,'&lt;')}“</div>`:''}`;
  if(cur.yn&&up===drawn.length){
    const w=[1,2,1];let sc=0;drawn.forEach((d,i)=>sc+=ynOf(d.c,d.rev)*w[i]);
    const [cls,lab,txt]=sc>=2?['v-yes','კი','ბარათები დადებით პასუხს აძლევენ.']:sc<=-2?['v-no','არა','ბარათები უარყოფით პასუხს აძლევენ — ან ახლა არ არის ამის დრო.']
      :['v-maybe','შესაძლოა','პასუხი ჯერ არ არის გადაწყვეტილი — ბევრი რამ შენს ქმედებაზეა დამოკიდებული.'];
    h+=`<div class="verdict ${cls}"><b>${lab}</b>${txt} <span style="color:var(--ink-dim);font-size:12px">(ქულა ${sc>0?'+':''}${sc} · კი = +1, შესაძლოა = 0, არა = −1, ცენტრი ×2)</span></div>`;
  }
  drawn.forEach((d,i)=>{
    const p=cur.p[i];
    if(!d.up){h+=`<div class="ri pending"><div class="no">${i+1}</div><div><div class="pos">${posLabel(i)} — ${p[1]}</div><div class="nm">დახურულია — დააჭირე ბარათს</div></div></div>`;return;}
    const c=d.c,yn=cur.yn?` · ${['არა','შესაძლოა','კი'][ynOf(c,d.rev)+1]}`:'';
    h+=`<div class="ri"><div class="no">${i+1}</div><div><div class="pos">${posLabel(i)} — ${p[1]}</div>
      <div class="nm">${c.major?ROMAN[c.n]+' ':''}${c.name}${d.rev?'<span class="rv">შებრუნებული</span>':''}</div>
      <div class="tags">${cardTags(c)}${yn}</div><div class="mn">${d.rev?c.rv:c.up}</div></div></div>`;
  });
  if(up===drawn.length&&drawn.length)h+=analyse(cur,drawn);
  else if(drawn.length)h+=`<div class="note">გადაბრუნებულია ${up} / ${drawn.length} — ბალანსი გამოჩნდება ყველას გადაბრუნების შემდეგ.</div>`;
  R.innerHTML=h;
}
function copyText(){
  const lines=[`ტარო — ${cur.t}`];if(question)lines.push(`კითხვა: ${question}`);
  drawn.forEach((d,i)=>{if(!d.up)return;const c=d.c;
    lines.push(`${i+1}. ${posLabel(i)}: ${c.major?ROMAN[c.n]+' ':''}${c.name}${d.rev?' (შებრ.)':''} — ${d.rev?c.rv:c.up}`);});
  const q=quintessence(drawn.filter(d=>d.up));if(q&&drawn.every(d=>d.up))lines.push(`კვინტესენცია: ${ROMAN[q.n]} ${MAJORS[q.n][0]}`);
  const txt=lines.join('\n');
  (navigator.clipboard?navigator.clipboard.writeText(txt):Promise.reject()).then(()=>{$('copy').textContent='✔ დაკოპირდა';
    setTimeout(()=>$('copy').textContent='ტექსტის კოპირება',1500);}).catch(()=>prompt('დააკოპირე:',txt));
}

/* ── encyclopedia ── */
let encF='all';
function renderEnc(){
  const F=[['all','ყველა'],['major','დიდი არკანი'],['wands','კვერთხები'],['cups','თასები'],['swords','მახვილები'],['pentacles','პენტაკლები']];
  $('enc-f').innerHTML=F.map(([k,t])=>`<button class="chip${k===encF?' on':''}" data-f="${k}">${t}</button>`).join('');
  $('enc-f').querySelectorAll('.chip').forEach(b=>b.onclick=()=>{encF=b.dataset.f;renderEnc();});
  const col={major:'var(--major)',fire:'var(--fire)',water:'var(--water)',air:'var(--air)',earth:'var(--earth)'};
  $('enc-g').innerHTML=DECK.filter(c=>encF==='all'||(encF==='major'?c.major:c.suit===encF)).map(c=>
    `<div class="enc-c" style="--elc:${col[c.el]}"><b>${c.major?ROMAN[c.n]+' ':''}${c.name}</b><div class="t">${cardTags(c)} · კი/არა: ${{y:'კი',m:'შესაძლოა',n:'არა'}[c.yn]}</div>
     <div class="u">▲ ${c.up}</div><div class="r">▼ ${c.rv}</div></div>`).join('');
}

$('draw').onclick=draw;$('flipall').onclick=flipAll;$('copy').onclick=copyText;
['opt-a','opt-b'].forEach(id=>$(id).addEventListener('input',()=>{if(drawn.length){
  document.querySelectorAll('.slot .pn').forEach((el,i)=>el.innerHTML=`<b>${i+1}</b>${posLabel(i)}`);renderReading();}else layoutEmpty();}));
const qs=new URLSearchParams(location.search).get('spread');
select(SPREADS.some(s=>s.id===qs)?qs:'daily');
renderEnc();
window._tarot={DECK,SPREADS,quintessence,ynOf,analyse};
</script>
</body>
</html>
